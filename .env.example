# ============================================================
# AviShifo environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ============================================================

NODE_ENV=development

# --- API ---
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
DISPLAY_URL=http://localhost:3002
PORTAL_URL=http://localhost:3003
# Comma-separated CORS allow-list
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://avishifo:avishifo@localhost:5432/avishifo?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT (RS256) ---
# Generate with: pnpm keys:generate  (writes .keys/jwt-private.pem / .keys/jwt-public.pem)
JWT_PRIVATE_KEY_PATH=.keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- File storage ---
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- SMS (Eskiz.uz). Leave PROVIDER=log in dev: messages go to logs. ---
SMS_PROVIDER=log                # log | eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Telegram bot (patient bot: linking, results, documents, reminders) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=          # bot @username without @ — needed for portal deep links

# --- Telegram Gateway (gatewayapi.telegram.org) ---
# Delivers verification codes to ANY phone registered on Telegram, shown by the
# verified "Verification Codes" sender — no /start, no bot linking. Used for
# portal sign-in codes, the second factor and passwordless staff sign-in, ahead
# of SMS and behind a chat the user has already linked.
# Get a token at https://gateway.telegram.org (paid per delivered message;
# undelivered messages are refunded). Empty = channel disabled.
TELEGRAM_GATEWAY_TOKEN=
# Optional: a verified channel you own to send as, instead of the generic sender.
TELEGRAM_GATEWAY_SENDER=
# Which Telegram route carries verification codes when both work:
#   gateway = the "Verification Codes" sender — same for everyone, ~$0.01/code
#   bot     = the user's linked AviShifo chat — free, but only if they linked it
# The other one is the fallback either way; SMS is the last resort.
VERIFICATION_CODE_CHANNEL=gateway

# --- Payments (sandbox creds) ---
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# --- Frontend (Next.js public) ---
# Leave EMPTY to use the same origin as the page (recommended behind nginx:
# the browser calls <page-origin>/api and /socket.io, which nginx proxies to the
# backend). Set an explicit URL only for a separate-API-domain deployment.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
# TV queue display base URL (used by the display-token QR/link in settings).
# Leave EMPTY to auto-derive from the panel origin: crm.<domain> → tv.crm.<domain>,
# localhost → localhost:3002. Set explicitly only if the display lives elsewhere.
NEXT_PUBLIC_DISPLAY_URL=

# Patient portal base URL (used by the landing page's "for patients" door).
# Leave EMPTY to auto-derive from the panel origin: crm.<domain> → bemor.<domain>,
# localhost → localhost:3003.
NEXT_PUBLIC_PORTAL_URL=

# Domain whose apex serves the marketing landing (no scheme, no www), e.g. avishifo.uz.
# This is what splits the hosts: <this>/www -> landing, crm.<this> -> staff panel.
# Leave EMPTY for a deployment that serves the landing and the panel from ONE
# origin (the legacy crm.avilab.uz box, a bare IP, local dev) — no host redirects
# happen then.
NEXT_PUBLIC_MARKETING_HOST=avishifo.uz
# Staff panel base URL. Leave EMPTY to derive it as crm.<NEXT_PUBLIC_MARKETING_HOST>.
NEXT_PUBLIC_PANEL_URL=
# Staff panel base URL. The landing lives on the apex (avishifo.uz) while login
# and sign-up live on crm.avishifo.uz, so every clinic CTA and the middleware's
# /<locale>/login redirect need to know the panel host.
# Leave EMPTY to auto-derive: apex/www.<domain> → crm.<domain>; crm.* and
# localhost/bare IP → their own origin. Set it only if the panel is somewhere
# else (e.g. the landing is served from a host that is not the apex).
NEXT_PUBLIC_PANEL_URL=
# Public bot handle shown on the security page ("open @<bot>"), without the @.
NEXT_PUBLIC_TELEGRAM_BOT=AviShifoBot

# --- Cookies ---
# Refresh cookie Secure flag. Leave unset in production (HTTPS → secure).
# Set "false" ONLY for a plain-HTTP demo (e.g. bare IP before TLS is set up).
COOKIE_SECURE=

# --- Self-service sign-up & trial ---
# Free-trial length for a clinic that registers itself at /register.
TRIAL_DAYS=7

# --- AviShifo AI (Google Gemini) ---
# Empty = the assistant is disabled everywhere: no /ai endpoint, no menu entry.
# The model never sees a clinic id and can only call a fixed set of read-only
# tools, each scoped to the caller's own clinic and permissions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Questions per clinic per hour (one question can cost several model calls).
AI_HOURLY_LIMIT=60
# Shown to a clinic whose trial has run out (the "Murojaat qilish" button).
# Telegram takes precedence over the phone when both are set.
SUPPORT_PHONE=
SUPPORT_TELEGRAM=            # username without @, e.g. avishifo_support
# Trial length shown in the sign-up copy — keep equal to TRIAL_DAYS.
NEXT_PUBLIC_TRIAL_DAYS=7

# --- Demo helpers ---
# Show role-based demo accounts on the staff login page (set "false" in production)
NEXT_PUBLIC_DEMO_LOGINS=true
