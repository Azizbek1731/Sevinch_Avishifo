# ============================================================
# AviShifo environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ============================================================

NODE_ENV=development

# --- API ---
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
DISPLAY_URL=http://localhost:3002
PORTAL_URL=http://localhost:3003
# Comma-separated CORS allow-list
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# --- Database (docker-compose defaults) ---
DATABASE_URL=postgresql://avishifo:avishifo@localhost:5432/avishifo?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT (RS256) ---
# Generate with: pnpm keys:generate  (writes .keys/jwt-private.pem / .keys/jwt-public.pem)
JWT_PRIVATE_KEY_PATH=.keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- File storage ---
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- SMS (Eskiz.uz). Leave PROVIDER=log in dev: messages go to logs. ---
SMS_PROVIDER=log                # log | eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Telegram bot ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# --- Payments (sandbox creds) ---
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# --- Frontend (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
