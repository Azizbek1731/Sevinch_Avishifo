{
  "name": "avishifo",
  "private": true,
  "version": "0.1.0",
  "description": "AviShifo — multi-tenant clinic CRM/HIS for private clinics in Uzbekistan",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "//": "redis-memory-server exists only for scripts/dev-local.mjs. Its postinstall compiles Redis (and RedisTimeSeries) from source, which fails on a clean server and takes the whole install down with it — leaving node_modules/.bin unlinked, so `prisma` and every other binary vanish. It fetches what it needs at first use anyway.",
    "neverBuiltDependencies": [
      "redis-memory-server"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:clinic": "node --env-file=.env scripts/dev-clinic.mjs",
    "build:clinic": "node --env-file=.env scripts/start-clinic.mjs --build-only",
    "start:clinic": "node --env-file=.env scripts/start-clinic.mjs",
    "clinic:server": "node --env-file=.env scripts/clinic-server.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "db:migrate": "pnpm --filter @avishifo/api db:migrate",
    "db:seed": "pnpm --filter @avishifo/api db:seed",
    "db:seed-surgery-demo": "pnpm --filter @avishifo/api exec tsx prisma/seed-surgery-demo.ts",
    "db:seed-prescription-directory": "pnpm --filter @avishifo/api exec tsx prisma/seed-prescription-directory.ts",
    "db:studio": "pnpm --filter @avishifo/api db:studio",
    "keys:generate": "node scripts/generate-keys.mjs",
    "logo:export": "node scripts/export-logo.mjs .",
    "dev:services": "node scripts/dev-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "redis-memory-server": "^0.17.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
