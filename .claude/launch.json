{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "avishifo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "avishifo-api-only",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@avishifo/api", "dev"],
      "port": 3001,
      "url": "http://localhost:3001"
    },
    {
      "name": "avishifo-web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@avishifo/web", "exec", "next", "dev", "-p", "3010"],
      "port": 3010
    },
    {
      "name": "avishifo-display",
      "port": 3002,
      "url": "http://localhost:3002"
    },
    {
      "name": "avishifo-portal",
      "port": 3003,
      "url": "http://localhost:3003"
    }
  ]
}
